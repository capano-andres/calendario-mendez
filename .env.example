# Copia este archivo como ".env" y completa los valores de tu proyecto Supabase
# (Supabase > Project Settings > API Keys y Data API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-publishable-key

# Emails de las dos cuentas de acceso creadas en Supabase > Authentication > Users.
VITE_EMAIL_LECTURA=lectura@example.com
VITE_EMAIL_SECRETARIA=secretaria@tuempresa.com
